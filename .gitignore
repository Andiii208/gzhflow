# 忽略运行产物与本地配置

# 生成产物
generated/
outputs/
dist/
build/

# 本地配置（含真实凭证）
config/*.yaml
config/*.yml
!config/*.example.yaml
!config/*.example.yml

# 环境变量
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 图片运行产物
*.jpg
*.jpeg
*.png
*.gif
!assets/**/*.png
!assets/**/*.jpg
!examples/**/*.png
!examples/**/*.jpg

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 本地备份
.local/

# git worktree 开发目录
.worktrees/

# 个人数据：本地留着用，不进公开仓库
# 这个仓库开源的是流程和方法论，不是你写过的内容。
# 已随 v0.2.0 发出去过一轮，git 历史里仍能翻到；真要彻底清除得重写历史。
state.md
assets/inbox.md
assets/log.md
references/seed-inbox-*.md
assets/voice-samples/*
!assets/voice-samples/README.md
